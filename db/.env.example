# Anslutningssträng till pappa-databasen.
#
# Neon CLI:er (neon env pull) skriver .env.local i repo-roten med båda
# varianterna. Skripten i db/ läser .env.local automatiskt - du behöver
# alltså inte exportera något manuellt.
#
# LÄGG INTE .env/.env.local I GIT (se .gitignore).

# Lokal dev-container
DATABASE_URL=postgresql://pappa:pappa@127.0.0.1:55432/pappa

# Neon (exempel - byt ut din egen)
# Poolad  - normal frågetrafik (applikationen).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
#
# Direkt  - migrationer, pg_dump/pg_restore och sessionsbunden SQL.
#           Måste INTE peka på -pooler: PgBouncer i transaktionsläge klarar
#           inte sessionstillstånd (SET search_path, extensions).
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Supabase (exempel)
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Ägare av bevakningslistan (vem som ansvarar för kontakter)
WATCHLIST_OWNER=
