# Anslutningssträngar mot Neon (Lakebase Postgres).
#
# Kopiera till neon.env och fyll i, eller kör ./sync-env.sh som plockar
# värdena ur ../../src/neon/.env.local (Neon CLI:ns fil).
#
# neon.env får ALDRIG committas - .gitignore i den här katalogen skyddar den.
#
# DATABASE_URL          - poolad endpoint (-pooler, PgBouncer): används av appen
# DATABASE_URL_UNPOOLED - direkt endpoint: migrationer, pg_dump, restore
#
# Se db/README.md om varför de två skiljer sig åt.

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
